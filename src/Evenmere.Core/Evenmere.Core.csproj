<Project Sdk="Microsoft.NET.Sdk">

  <!-- Core references nothing but the BCL and System.IO.Hashing. See ADR-0002. -->

  <ItemGroup>
    <PackageReference Include="System.IO.Hashing" />
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="..\BannedSymbols.txt" />
  </ItemGroup>

  <!-- Lets tests read internal diagnostics such as IdTable.SlotCountForTests (generates [assembly: InternalsVisibleTo]). -->
  <ItemGroup>
    <InternalsVisibleTo Include="Evenmere.Core.Tests" />
  </ItemGroup>

</Project>
