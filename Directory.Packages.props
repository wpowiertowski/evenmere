<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="Microsoft.Testing.Extensions.TrxReport" Version="2.5.1" />
    <!-- TrxReport 2.5.1 tracks the Microsoft.Testing.Platform 2.5.1 resolved transitively through
         Microsoft.NET.Test.Sdk 18.11.0. It enables the MTP report-trx flag so CI can upload
         TRX result files without changing local runs. -->
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0" />
    <PackageVersion Include="System.IO.Hashing" Version="10.0.13" />
    <PackageVersion Include="MessagePack" Version="3.1.12" />
    <PackageVersion Include="System.CommandLine" Version="2.0.13" />
    <!-- 8.0.5 is the last MIT-licensed release. 9.x ships under the Open Source Maintenance Fee EULA (a fee for users with revenue of US$10,000 a year or more), so move to it only as a deliberate decision. The code is tested with both. -->
    <PackageVersion Include="JsonSchema.Net" Version="8.0.5" />
  </ItemGroup>

</Project>
